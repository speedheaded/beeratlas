# Репозиторий заводился на Windows, работа идёт и в WSL. Без этого правила
# каждый переезд показывает все файлы изменёнными целиком: CRLF против LF.
# Ровно так и вышло 31 августа — 41 000 «изменённых» строк без единой правки.
* text=auto eol=lf

# Двоичное не трогать, если появится
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
